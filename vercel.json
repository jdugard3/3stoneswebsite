{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "website": {
      "root": "artifacts/3stones-website",
      "framework": "vite",
      "installCommand": "npx pnpm@12.10.1 install --frozen-lockfile",
      "buildCommand": "npx pnpm@12.10.1 run build",
      "outputDirectory": "dist/public",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "api": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "installCommand": "npx pnpm@12.10.1 install --frozen-lockfile"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "website" } }
  ]
}
